# PostgreSQL connection. On Railway this is ${{Postgres.DATABASE_URL}}.
DATABASE_URL="postgresql://user:password@localhost:5432/aera_dev"

# Signs session and challenge cookies. Use a long random value in production.
AUTH_SECRET="change-me"

# Set to 1 to show the demo accounts from prisma/seed.ts on the login page.
AERA_DEMO=0
